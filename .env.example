# ---------------------------------------------------------------------------
# Metagomics 2 — Environment Configuration
# ---------------------------------------------------------------------------
# This file contains simple scalar settings and paths.  Structured data such
# as database definitions belong in JSON config files (see config/ directory).
# Copy this file to .env and edit to match your setup.
# ---------------------------------------------------------------------------

# --- Filesystem Paths ---

# Host directory for persistent data (jobs, SQLite database, etc.)
# Mounted into the container at /data.
METAGOMICS_DATA_DIR=./_data

# Host directory containing DIAMOND-formatted annotated databases (.dmnd files).
# Mounted read-only into the container at /databases.
METAGOMICS_DATABASES_DIR=./_databases

# Directory containing JSON config files (databases.json, server.json).
# Mounted into the container at /config.
METAGOMICS_CONFIG_DIR=./config

# --- Runtime Settings ---

# Number of CPU threads for compute-intensive tasks (e.g. DIAMOND).
METAGOMICS_THREADS=4

# --- DIAMOND Performance and Memory ---
#
# DIAMOND searches the annotated database in "blocks". For every block it
# loads that slice of the database, builds a seed index (mostly single-
# threaded), then searches the query proteins against it (multi-threaded).
# A large database at the default block size means many blocks, and most of
# the wall-clock time goes into per-block setup where your threads sit idle.
# Fewer, bigger blocks are much faster but need more memory.
#
# All three settings below are optional. Leave them empty to use DIAMOND's
# own defaults, which are safe on small machines. Values here are passed
# straight through to the diamond command line; the worker logs the resulting
# command and an approximate memory budget at the start of every job.
#
# METAGOMICS_DIAMOND_BLOCK_SIZE  (diamond --block-size, DIAMOND default 2.0)
#   Billions of database letters processed per block. This is THE knob for
#   DIAMOND's memory use. Rule of thumb from the DIAMOND manual: expect up to
#   about 6 GB of RAM per unit, so 2.0 -> ~12 GB, 8.0 -> ~48 GB, 20 -> ~120 GB.
#   In practice usage is often lower (a 2.0 run was observed at 4 GB), so
#   treat 6x as the budget you must be able to afford, not a prediction.
#   Temporary disk (or RAM if using /dev/shm below) grows with it too.
#   Rough guide: number of blocks ~= database .dmnd size in GB / block size.
#   On a SHARED server pick the value from the memory you can dedicate to
#   this container, not from the total on the machine: e.g. 8.0 if you can
#   spare ~50 GB. Never set it so 6x exceeds what you can give DIAMOND.
#
# METAGOMICS_DIAMOND_INDEX_CHUNKS  (diamond --index-chunks, DIAMOND default 4)
#   How many chunks the seed index of each block is processed in. 1 is the
#   fastest and the DIAMOND manual recommends it for high-memory servers,
#   but it raises memory use for the same block size. Only lower this from
#   the default (i.e. set it to 1) once the block size is settled and you
#   have headroom. Leave it at 4 on a memory-constrained or shared host.
#
# METAGOMICS_DIAMOND_TMPDIR  (diamond --tmpdir, default: the job's work dir)
#   Where DIAMOND keeps its per-block intermediate results. On a big-memory
#   host, /dev/shm keeps them in RAM and takes the disk out of the join phase.
#   Warning: /dev/shm inside a Docker container is only 64 MB unless you raise
#   it (shm_size: in docker-compose.yml, see docker-compose.example.yml), and
#   whatever DIAMOND writes there counts against the container's memory.
#   Leave empty on a shared host unless you have set shm_size deliberately.
#
# Example for a dedicated 256 GB server:  BLOCK_SIZE=20, INDEX_CHUNKS=1
# Example for ~50 GB on a shared server:  BLOCK_SIZE=8,  INDEX_CHUNKS=4
METAGOMICS_DIAMOND_BLOCK_SIZE=
METAGOMICS_DIAMOND_INDEX_CHUNKS=
METAGOMICS_DIAMOND_TMPDIR=

# Admin password for the /admin dashboard.
METAGOMICS_ADMIN_PASSWORD=changeme

# Maximum upload size in megabytes for FASTA and peptide files.
# Uploads exceeding this limit are rejected with a 413 error.
METAGOMICS_MAX_UPLOAD_MB=1024

# Whether to delete inputs/ and work/ directories after a job completes.
# Set to "false" to keep intermediate files for debugging.
METAGOMICS_CLEANUP_ON_SUCCESS=true
METAGOMICS_CLEANUP_ON_FAILURE=true

# Log level for the worker and web server: DEBUG, INFO, WARNING or ERROR.
# Logs go to the container's stdout/stderr (docker logs) and to
# $METAGOMICS_DATA_DIR/logs/{worker,server}.log; each job also gets
# $METAGOMICS_DATA_DIR/jobs/<job_id>/logs/{pipeline,diamond}.log.
METAGOMICS_LOG_LEVEL=INFO

# --- Email Notifications (optional) ---
# If SMTP_HOST is set, users can optionally provide an email address when
# submitting a job.  A notification is sent when the job completes or fails.
# Leave SMTP_HOST empty to disable email notifications entirely.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Sender address shown in the "From" field.  Falls back to SMTP_USERNAME.
SMTP_FROM=

# Public base URL of this instance (e.g. https://metagomics.example.com).
# Used to build clickable job links in notification emails.
SITE_URL=
